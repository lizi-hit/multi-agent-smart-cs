# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v3

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Graph Retry/Timeout
GRAPH_TIMEOUT_SECONDS=20
GRAPH_MAX_RETRIES=1

# External service integration (optional, fallback to mock when empty)
ORDER_SERVICE_URL=
TICKET_SERVICE_URL=
RISK_SERVICE_URL=

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000
